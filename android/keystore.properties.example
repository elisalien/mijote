# Copy to android/keystore.properties (gitignored — never commit real values).
# Generate the keystore locally with:
#   keytool -genkeypair -v -keystore mijote-release.keystore -alias mijote \
#     -keyalg RSA -keysize 2048 -validity 10000
# Keep mijote-release.keystore + these passwords somewhere safe and durable
# (password manager, offline backup). Losing them means you can no longer
# publish updates to the same Play Store listing (unless you enrolled in
# Play App Signing, in which case Google can help you reset the *upload* key).

storeFile=../mijote-release.keystore
storePassword=CHANGE_ME
keyAlias=mijote
keyPassword=CHANGE_ME
